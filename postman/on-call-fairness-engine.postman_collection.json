{
  "info": {
    "name": "On-Call Fairness Engine Postman Collection",
    "description": "Intelligent on-call rotation management platform. Balances on-call burden \nfairly across engineers by considering weekends, holidays, night shifts, \nincident load, and personal preferences. Tracks burnout risk, enforces \nlabor regulations, and provides transparent fairness scores so every \nengineer sees they are being treated equally.\n\nOpenAPI version: 3.0.3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://oncallfairness.forgesphere.lightning.com/v1",
      "type": "string",
      "description": "Override with the base URL of the deployed Kong gateway."
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "rotationId",
      "value": "",
      "type": "string",
      "description": "Unique identifier of the rotation."
    },
    {
      "key": "fromDate",
      "value": "",
      "type": "string",
      "description": "Start date of the schedule window."
    },
    {
      "key": "toDate",
      "value": "",
      "type": "string",
      "description": "End date of the schedule window."
    },
    {
      "key": "shiftId",
      "value": "",
      "type": "string",
      "description": "Unique identifier of the shift."
    },
    {
      "key": "windowDays",
      "value": "",
      "type": "string",
      "description": "How far back to analyze (days)."
    }
  ],
